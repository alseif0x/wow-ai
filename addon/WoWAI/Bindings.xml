<Bindings>
	<Binding name="WOWAI_TOGGLE" header="WOWAI" category="ADDONS">
		WoWAI.Toggle()
	</Binding>
	<Binding name="WOWAI_PAD" category="ADDONS">
		WoWAIPad.Toggle()
	</Binding>
	<Binding name="WOWAI_TALK" runOnUp="true" category="ADDONS">
		WoWAIPad.TalkBinding(keystate)
	</Binding>
	<Binding name="WOWAI_SHOT" category="ADDONS">
		WoWAI.ArmShot()
	</Binding>
</Bindings>
